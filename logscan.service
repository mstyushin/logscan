# systemd unit for running logscan as a Telegram bot service.
#
#   User/Group       : the service account that runs logscan. It must have read access
#                      to /opt/logscan and any log file you want it to analyze. Also,
#                      it must have write access to configured reports directory.
#   WorkingDirectory : path to virtualenv for logscan.
#   ExecStart        : path to logscan executable, assuming it was installed from wheel.
#   EnvironmentFile  : config file with OPENTIP_API_KEY / TELEGRAM_TOKEN / etc.
#
# Installation:
#   sudo cp logscan.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now logscan.service

[Unit]
Description=logscan log analysis and threat detection (Telegram bot service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=logscan
Group=logscan

WorkingDirectory=/opt/logscan
EnvironmentFile=-/etc/logscan/logscan.env
ExecStart=/opt/logscan/bin/logscan --service

Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/logscan/reports

[Install]
WantedBy=multi-user.target
